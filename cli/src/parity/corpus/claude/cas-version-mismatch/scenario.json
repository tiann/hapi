{
  "flavor": "claude",
  "argv": [
    "claude",
    "--hapi-starting-mode",
    "remote",
    "--started-by",
    "runner",
    "--hapi-session-id",
    "a1111111-1111-4111-8111-111111111111"
  ],
  "env": {},
  "hubScript": [
    {
      "forceVersionMismatch": {
        "event": "update-state",
        "patch": {
          "completedRequests": {}
        }
      }
    },
    {
      "forceVersionMismatch": {
        "event": "update-metadata",
        "patch": {
          "forkedFrom": "parent-session"
        }
      }
    },
    {
      "delayAck": 5
    },
    {
      "sendUpdate": {
        "t": "new-message",
        "message": {
          "id": "message-1",
          "localId": "local-1",
          "seq": 1,
          "createdAt": 1,
          "content": {
            "role": "user",
            "content": {
              "type": "text",
              "text": "hello"
            }
          }
        }
      },
      "until": [
        {
          "event": "message",
          "contains": "\"type\":\"ready\""
        },
        {
          "event": "update-metadata",
          "result": "success",
          "count": 2
        },
        {
          "event": "update-metadata",
          "contains": "\"summary\":",
          "result": "success"
        },
        {
          "event": "update-state",
          "result": "success",
          "count": 2
        },
        {
          "event": "update-state",
          "contains": "\"steeringActive\":false",
          "result": "success"
        },
        {
          "event": "update-state",
          "result": "version-mismatch"
        },
        {
          "event": "update-metadata",
          "result": "version-mismatch"
        },
        {
          "event": "update-state",
          "contains": "\"completedRequests\":{}",
          "result": "success"
        },
        {
          "event": "update-metadata",
          "contains": "\"forkedFrom\":\"parent-session\"",
          "result": "success"
        }
      ],
      "release": [
        {
          "after": {
            "event": "update-state",
            "result": "success",
            "contains": "\"steeringActive\":true"
          },
          "marker": "state-retried"
        },
        {
          "after": {
            "event": "update-metadata",
            "result": "success",
            "contains": "\"claudeSessionId\":"
          },
          "marker": "metadata-retried"
        }
      ]
    },
    {
      "signal": "SIGTERM",
      "settledAlive": {
        "effort": null,
        "mode": "remote",
        "model": null,
        "permissionMode": "default",
        "thinking": false
      }
    }
  ],
  "agentScript": "agent.jsonl",
  "timeoutMs": 120000
}
