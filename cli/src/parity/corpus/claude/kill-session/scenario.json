{
  "flavor": "claude",
  "argv": [
    "claude",
    "--hapi-starting-mode",
    "remote",
    "--started-by",
    "runner",
    "--hapi-session-id",
    "a1111111-1111-4111-8111-111111111111"
  ],
  "env": {},
  "hubScript": [
    {
      "rpc": "killSession",
      "params": {
        "expectedMachineId": "other-machine"
      },
      "expectAck": {
        "error": "Session machine does not match shutdown target"
      }
    },
    {
      "rpc": "killSession",
      "params": {
        "expectedPid": 1
      },
      "expectAck": {
        "error": "Session process generation does not match shutdown target"
      }
    },
    {
      "rpc": "killSession",
      "params": {
        "expectedPid": "$pid",
        "expectedProcessStartMarker": "$marker",
        "prepareOnly": true,
        "preparationLease": {
          "id": "parity-lease",
          "expiresAt": 1
        }
      },
      "expectAck": {
        "error": "Session shutdown preparation lease is invalid or expired"
      }
    },
    {
      "rpc": "killSession",
      "params": {
        "expectedPid": "$pid",
        "expectedProcessStartMarker": "$marker",
        "prepareOnly": true,
        "preparationLease": {
          "id": "parity-lease",
          "expiresAt": "$leaseExpiry"
        }
      },
      "expectAck": {
        "success": true,
        "message": "Session shutdown prepared"
      }
    },
    {
      "rpc": "killSession",
      "params": {
        "expectedPid": "$pid",
        "expectedProcessStartMarker": "$marker"
      },
      "expectAck": {
        "success": true
      },
      "settledAlive": {
        "effort": null,
        "mode": "remote",
        "model": null,
        "permissionMode": "default",
        "thinking": false
      }
    }
  ],
  "agentScript": "agent.jsonl",
  "timeoutMs": 120000
}
