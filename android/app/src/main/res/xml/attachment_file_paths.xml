<?xml version="1.0" encoding="utf-8"?>
<!-- Camera-capture scratch files for composer attachments (B-M3f):
     cache/attachments/camera-*.jpg handed to TakePicture via FileProvider,
     deleted right after ingest. -->
<paths>
    <cache-path name="text_exports" path="text-exports/" />
    <cache-path
        name="attachment_captures"
        path="attachments/" />
    <!-- Generated media downloads (chat blocks): cache/generated-media/
         files opened via ACTION_VIEW in external players. -->
    <cache-path
        name="generated_media"
        path="generated-media/" />
    <!-- Shared turn card images (cache/share-images/), handed to the system
         share panel via FileProvider; written fresh per share. -->
    <cache-path
        name="share_images"
        path="share-images/" />
</paths>
