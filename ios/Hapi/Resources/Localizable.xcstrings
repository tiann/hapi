        }
      }
    },
    "Shown in the hub's passkey list so you can tell your devices apart." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hub のパスキー一覧に表示され、デバイスを見分けるのに役立ちます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отображается в списке ключей хаба, чтобы различать устройства."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示在 Hub 的通行密钥列表中，便于区分你的设备。"
          }
        }
      }
    },
    "Sign in to %@ from another device with “Sign in with a Passkey” — no access token needed. Passkeys work in both the web app and this app." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のデバイスから「パスキーでサインイン」を使って %@ にサインインできます。アクセストークンは不要です。パスキーは Web アプリとこのアプリの両方で使えます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войдите в %@ с другого устройства через «Войти с ключом доступа» — токен доступа не нужен. Ключи работают и в браузере, и в этом приложении."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在其他设备上通过“使用通行密钥登录”登录 %@，无需访问令牌。通行密钥可同时用于网页版和本应用。"
          }
        }
      }
    },
