          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用会先确认 Hub 可达，再用令牌换取会话。"
          }
        }
      }
    },
    "The attachments exceed the scratchlist limits — remove a file or choose a smaller one" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
