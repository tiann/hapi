    "The hub could not register the passkey (HTTP %lld)." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hub がパスキーを登録できませんでした（HTTP %lld）。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хаб не смог зарегистрировать ключ доступа (HTTP %lld)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hub 无法注册通行密钥（HTTP %lld）。"
          }
        }
      }
    },
    "The hub did not accept this passkey. It may have been deleted, or the hub's access token was rotated. Pair with the access token instead." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hub がこのパスキーを受け付けませんでした。削除されたか、Hub のアクセストークンがローテーションされた可能性があります。代わりにアクセストークンでペアリングしてください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хаб не принял этот ключ доступа. Возможно, он удалён или токен доступа хаба был сменён. Подключитесь с токеном доступа."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hub 未接受此通行密钥。它可能已被删除，或 Hub 的访问令牌已轮换。请改用访问令牌配对。"
          }
        }
      }
    },
    "The hub requested a passkey for “%@”, but this app only supports auth.hapi.run. Update the hub." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hub が「%@」のパスキーを要求しましたが、このアプリは auth.hapi.run のみに対応しています。Hub を更新してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хаб запросил ключ доступа для «%@», но приложение поддерживает только auth.hapi.run. Обновите хаб."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hub 请求的是“%@”的通行密钥，但本应用仅支持 auth.hapi.run。请更新 Hub。"
          }
        }
      }
    },
    "This device could not create the passkey: %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスでパスキーを作成できませんでした：%@"
