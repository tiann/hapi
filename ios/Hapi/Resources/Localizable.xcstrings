{
  "sourceLanguage": "en",
  "strings": {
    "%@\n\nOpen a session chat to browse its files.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\n打开会话聊天即可浏览其文件。"
          }
        }
      }
    },
    "%@ (%lld edits)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（%lld 处编辑）"
          }
        }
      }
    },
