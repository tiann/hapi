    "Registered before the hub's access token was rotated; it can no longer sign in." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hub のアクセストークンがローテーションされる前に登録されたため、サインインできません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зарегистрирован до смены токена доступа хаба; вход с ним больше невозможен."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Hub 访问令牌轮换前注册，已无法用于登录。"
          }
        }
      }
    },
    "Revoked" : {
      "extractionState" : "manual",
