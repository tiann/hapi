    "%@\n\nOpen a session chat to browse its files." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nОткройте чат сессии, чтобы просмотреть её файлы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n打开会话聊天即可浏览其文件。"
