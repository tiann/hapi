        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备无法创建通行密钥：%@"
          }
        }
      }
    },
    "This device could not use a passkey for this hub. Try again, or pair with the access token." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスでこの Hub のパスキーを使用できませんでした。もう一度お試しいただくか、アクセストークンでペアリングしてください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это устройство не смогло использовать ключ доступа для этого хаба. Повторите попытку или подключитесь с токеном доступа."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备无法为该 Hub 使用通行密钥。请重试，或使用访问令牌配对。"
          }
        }
      }
    },
    "This hub does not support passkeys. Update the hub to use them." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
