                    "limit": 200,
                    "untilAt": null,
                    "untilSeq": null
                }
            ],
            "op": "sync-tail",
            "responses": [
                {
                    "messages": [
                        {
                            "content": {
                                "content": {
                                    "data": {
                                        "message": "fresh-2",
                                        "type": "message"
                                    },
                                    "type": "codex"
                                },
