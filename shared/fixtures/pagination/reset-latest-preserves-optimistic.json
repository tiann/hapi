{
    "description": "A tail sync that gets page.reset:true replaces every server row from before the request but keeps optimistic rows (id === localId): the not-yet-echoed send survives the epoch bump and the window adopts the new epoch and cursors.",
    "expectedState": {
        "epoch": 2,
        "hasMore": false,
        "messages": [
            {
                "createdAt": 1500,
                "id": "local-1",
                "invokedAt": null,
                "localId": "local-1",
                "optimistic": true,
                "queued": true,
                "seq": null,
                "status": "sending"
            },
            {
                "createdAt": 2000,
                "id": "fresh-2",
                "invokedAt": 2000,
                "localId": null,
                "optimistic": false,
                "queued": false,
                "seq": 2
            }
        ],
        "newestCursor": {
            "at": 2000,
            "seq": 2
        },
        "olderCursor": {
            "at": 2000,
            "seq": 2
        },
        "viewMode": "tail"
    },
